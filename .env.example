# Live inference stays disabled. Rules mode requires no account or API key.
NEBIUS_ENABLED=false

# Enter a key only in your local .env or server secret manager, never in the browser/chat.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1

# Local-only by default. For a hosted demo set PUBLIC_HOSTS to the exact public hostname(s);
# hosted mode adds per-client and daily live-AI caps (see README "Hosted mode").
PORT=8787
PUBLIC_HOSTS=
LIVE_PER_IP_PER_HOUR=6
LIVE_DAILY_CAP=150
